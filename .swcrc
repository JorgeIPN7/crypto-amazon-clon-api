{
  "$schema": "https://json.schemastore.org/swcrc",
  "sourceMaps": true,
  "exclude": [".*\\.spec\\.ts$", ".*\\.e2e-spec\\.ts$", ".*/__tests__/.*"],
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "decorators": true,
      "dynamicImport": true
    },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true,
      "useDefineForClassFields": false
    },
    "keepClassNames": true,
    "target": "es2023",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@common/*": ["./src/common/*"],
      "@config/*": ["./src/config/*"],
      "@modules/*": ["./src/modules/*"],
      "@shared/*": ["./src/shared/*"],
      "@database/*": ["./src/database/*"],
      "@test/*": ["./test/*"]
    }
  },
  "module": {
    "type": "commonjs",
    "strictMode": true,
    "noInterop": false
  },
  "minify": false
}
