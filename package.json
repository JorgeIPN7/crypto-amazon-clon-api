{
  "name": "nest-base-template",
  "version": "0.0.1",
  "description": "NestJS 11 production-ready base (SWC, Pino, Zod config, Scalar/OpenAPI, Terminus)",
  "author": "Jorge H <jorge.ipn.7@gmail.com>",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JorgeIPN7/template-nest-js-hexagonal-ddd-mudblood.git"
  },
  "bugs": {
    "url": "https://github.com/JorgeIPN7/template-nest-js-hexagonal-ddd-mudblood/issues"
  },
  "homepage": "https://github.com/JorgeIPN7/template-nest-js-hexagonal-ddd-mudblood#readme",
  "engines": {
    "node": ">=24.19.0 <25.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{js,json,md,yml,yaml,cjs,mjs}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{js,json,md,yml,yaml,cjs,mjs}\" \".github/**/*.yml\"",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:ci": "jest --ci --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.config.mjs",
    "test:e2e:ci": "jest --config ./test/jest-e2e.config.mjs --ci --coverage",
    "test:mutation": "stryker run",
    "prepare": "husky",
    "commitlint": "commitlint --edit",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:generate",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "migration:run": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:run",
    "migration:revert": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:revert",
    "migration:show": "typeorm-ts-node-commonjs -d src/database/data-source.ts migration:show",
    "schema:log": "typeorm-ts-node-commonjs -d src/database/data-source.ts schema:log",
    "seed:admin": "ts-node src/database/seeds/seed-admin.ts",
    "outbox:relay": "ts-node src/database/outbox/relay-orders-outbox.ts",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait postgres && pnpm migration:run && pnpm db:migrate:test",
    "db:migrate:test": "node scripts/migrate-test-db.mjs",
    "init:project": "node scripts/init-project.mjs",
    "assets:scalar": "node scripts/copy-scalar-asset.mjs",
    "prebuild": "pnpm assets:scalar",
    "prestart:dev": "pnpm assets:scalar",
    "pretest:e2e": "pnpm assets:scalar",
    "pretest:e2e:ci": "pnpm assets:scalar"
  },
  "dependencies": {
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@nestjs/typeorm": "11.0.3",
    "@scalar/nestjs-api-reference": "1.2.14",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.1",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "nestjs-cls": "6.2.1",
    "nestjs-pino": "4.6.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "1.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@fast-check/jest": "2.2.0",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.1",
    "@scalar/api-reference": "1.65.1",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "@swc/cli": "0.8.1",
    "@swc/core": "1.16.1",
    "@swc/jest": "0.2.39",
    "@types/compression": "1.8.1",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-prettier": "5.5.6",
    "fast-check": "4.9.0",
    "globals": "17.11.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "secretlint": "13.0.4",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  },
  "lint-staged": {
    "{src,test}/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,json,md,yml,yaml}": [
      "prettier --write"
    ],
    "*": "secretlint --maskSecrets"
  }
}
