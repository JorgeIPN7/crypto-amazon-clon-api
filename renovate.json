{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":pinAllExceptPeerDependencies",
    "docker:pinDigests"
  ],
  "labels": ["dependencies"],
  "lockFileMaintenance": { "enabled": true },
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchFileNames": ["pnpm-workspace.yaml"],
      "enabled": false
    }
  ]
}
